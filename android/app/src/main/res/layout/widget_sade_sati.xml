<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="K S H A N A"
        android:textColor="#E3B96A"
        android:textSize="11sp"
        android:letterSpacing="0.2" />
    <TextView
        android:id="@+id/widget_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#E07A5F"
        android:textSize="15sp"
        android:fontFamily="serif"
        android:maxLines="2" />
    <TextView
        android:id="@+id/widget_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#EFE9DC"
        android:textSize="13sp"
        android:maxLines="2" />
    <TextView
        android:id="@+id/widget_line3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#9A9EB0"
        android:textSize="11sp"
        android:maxLines="2" />
    <TextView
        android:id="@+id/widget_line4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#E3B96A"
        android:textSize="11sp"
        android:maxLines="2" />
</LinearLayout>
